<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="IVI-IVAI Demo"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.IVAI">

        <activity
            android:name="net.hwyz.iov.vehicle.ivi.ivai.ui.chat.ChatActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="net.hwyz.iov.vehicle.ivi.ivai.ui.config.ModelConfigActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="net.hwyz.iov.vehicle.ivi.ivai.ui.config.asr.AsrConfigActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="net.hwyz.iov.vehicle.ivi.ivai.ui.settings.SettingsActivity"
            android:exported="false" />

        <activity
            android:name="net.hwyz.iov.vehicle.ivi.ivai.ui.settings.prompt.PromptInfoActivity"
            android:exported="false" />

        <activity
            android:name="net.hwyz.iov.vehicle.ivi.ivai.ui.settings.vehicle.VehicleInfoActivity"
            android:exported="false" />

        <activity
            android:name="net.hwyz.iov.vehicle.ivi.ivai.ui.settings.rag.RagConfigActivity"
            android:exported="false" />

        <service
            android:name="net.hwyz.iov.vehicle.ivi.ivai.service.AgentService"
            android:exported="false" />

    </application>

</manifest>
