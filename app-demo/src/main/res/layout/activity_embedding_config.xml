<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/chat_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bubble_agent"
        android:paddingStart="8dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <Button
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← 返回"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="嵌入模型配置"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="嵌入模型（Embedding Provider）"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="RAG 向量由该在线服务生成（OpenAI 兼容 /embeddings）。留空保存 = 回退本地默认嵌入；模型/维度变化会触发索引全量重建。"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="嵌入服务地址"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/baseUrlInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="例如 https://embed.example.com/v1"
                android:inputType="textUri"
                android:maxLines="2"
                android:importantForAutofill="no"
                android:paddingTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="模型标识（modelId）"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/modelIdInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="例如 text-embedding-v3"
                android:inputType="text"
                android:importantForAutofill="no"
                android:maxLines="1"
                android:paddingTop="4dp" />

            <Button
                android:id="@+id/advancedToggleButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="高级选项（模型版本 / 白名单）" />

            <LinearLayout
                android:id="@+id/advancedRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="模型版本（可选）"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/modelVersionInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="例如 v1（留空不限制）"
                    android:inputType="text"
                    android:importantForAutofill="no"
                    android:maxLines="1"
                    android:paddingTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="允许的 Host 白名单（逗号分隔，可选）"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/allowedHostsInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="例如 embed.example.com,embed2.example.com"
                    android:inputType="text"
                    android:importantForAutofill="no"
                    android:maxLines="2"
                    android:paddingTop="4dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="向量维度"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/dimensionInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="例如 768（必须与模型输出一致）"
                android:inputType="number"
                android:importantForAutofill="no"
                android:maxLines="1"
                android:paddingTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="超时（毫秒）"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/timeoutInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="10000"
                android:inputType="number"
                android:importantForAutofill="no"
                android:maxLines="1"
                android:paddingTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="重试次数"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/retriesInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="2"
                android:inputType="number"
                android:importantForAutofill="no"
                android:maxLines="1"
                android:paddingTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="批量大小（每请求文本数）"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/batchInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="16"
                android:inputType="number"
                android:importantForAutofill="no"
                android:maxLines="1"
                android:paddingTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="访问密钥"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/keyStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/apiKeyInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="输入新密钥（留空则保留已保存密钥）"
                    android:inputType="textPassword"
                    android:importantForAutofill="no"
                    android:maxLines="1" />

                <Button
                    android:id="@+id/toggleKeyButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="显示" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/clearKeyCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="清除已保存密钥"
                android:enabled="false" />

            <TextView
                android:id="@+id/errorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="13sp"
                android:textColor="#D32F2F"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/testButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="测试连接" />

                <Button
                    android:id="@+id/saveButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="保存" />
            </LinearLayout>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary" />

            <Button
                android:id="@+id/resetButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="恢复默认（清空并回退本地嵌入）" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
