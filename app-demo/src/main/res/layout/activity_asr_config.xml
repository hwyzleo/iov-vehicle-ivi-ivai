<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/chat_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bubble_agent"
        android:paddingStart="8dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <Button
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← 返回"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="语音识别配置"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Provider 类型"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/asrProviderSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="40dp" />

            <!-- Remote-only fields (HTTP_COMPATIBLE / VENDOR) -->
            <LinearLayout
                android:id="@+id/remoteFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="服务地址"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/asrBaseUrlInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="例如 https://asr.example.com/v1"
                    android:inputType="textUri"
                    android:maxLines="2"
                    android:importantForAutofill="no"
                    android:paddingTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="模型名称"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/asrModelNameInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="例如 whisper / funasr / 厂商模型 ID"
                    android:inputType="text"
                    android:maxLines="1"
                    android:importantForAutofill="no"
                    android:paddingTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="访问密钥"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/asrKeyStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/asrApiKeyInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="输入新密钥（留空则保留已保存密钥）"
                        android:inputType="textPassword"
                        android:importantForAutofill="no"
                        android:maxLines="1" />

                    <Button
                        android:id="@+id/asrToggleKeyButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="显示" />
                </LinearLayout>

                <CheckBox
                    android:id="@+id/asrClearKeyCheck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="清除已保存密钥"
                    android:enabled="false" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="识别语言"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/asrLanguageInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="例如 zh-CN"
                android:inputType="text"
                android:maxLines="1"
                android:importantForAutofill="no"
                android:paddingTop="4dp" />

            <CheckBox
                android:id="@+id/asrPreferOfflineCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="优先离线（仅为偏好，不作为离线保证）" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="连接超时（毫秒）"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/asrConnectTimeoutInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="默认 5000"
                android:inputType="number"
                android:maxLines="1"
                android:importantForAutofill="no"
                android:paddingTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="识别超时（毫秒，含 Finalizing 最大等待）"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/asrRecognitionTimeoutInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="默认 30000"
                android:inputType="number"
                android:maxLines="1"
                android:importantForAutofill="no"
                android:paddingTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="降级策略"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/asrFallbackSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="40dp" />

            <TextView
                android:id="@+id/asrErrorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="13sp"
                android:textColor="#D32F2F"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/asrTestButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="测试连接" />

                <Button
                    android:id="@+id/asrSaveButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="保存" />
            </LinearLayout>

            <TextView
                android:id="@+id/asrStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary" />

            <Button
                android:id="@+id/asrResetButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="恢复默认" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
