<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Push-to-talk speech input (IVI-IVAI-DSN-CR-006). The mic permission is
      declared here where the speech module lives and merged into the app;
      runtime request happens in the Chat screen via Activity Result API.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

</manifest>
